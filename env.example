# 应用 Base URL
APP_BASE_URL=http://localhost:8001
# Internal backend origin used by Web SSR, the site Blog proxy, and local tooling.
BACKEND_ORIGIN=http://localhost:8002
# Node/Hono Space Runtime is private behind the Backend membership gateway.
SPACE_RUNTIME_ORIGIN=http://127.0.0.1:8007
SPACE_RUNTIME_INTERNAL_TOKEN="replace-with-a-long-random-internal-token"
SPACE_RUNTIME_CALLBACK_ORIGIN=http://localhost:8002
# Optional Space Runtime tuning. Pi is the first adapter, not a platform contract.
SPACE_RUNTIME_PORT=8007
SPACE_AGENT_DEFAULT_ID="pi"
SPACE_AGENT_REGION="local"
# Keep disabled until a second real Adapter passes the S4 contract suite.
SPACE_AGENT_MULTI_AGENT_ENABLED=0
# Optional comma-separated resolvers for isolated AgentOS Apps build VMs.
# Local `pnpm dev` defaults to Cloudflare + Google DNS; production can omit this
# when its VM runtime already receives valid system DNS configuration.
# AGENTOS_APPS_DNS_SERVERS="1.1.1.1,8.8.8.8"
SPACE_AGENT_MAX_CONCURRENCY=2
SPACE_TURN_BATCH_WINDOW_MS=350
# Deprecated for one compatibility cycle: PI_MAX_CONCURRENCY and
# PI_BATCH_WINDOW_MS remain fallback aliases when the SPACE_* values are absent.
# PI_MODE="agentos" # or "host" when a local Pi CLI session is configured
# PI_BIN="/absolute/path/to/pi" # recommended for deployed Host Pi runtimes
# Public product origin used by the standalone site CTA.
VITE_WEB_APP_ORIGIN=http://localhost:8001
VITE_ADMIN_APP_ORIGIN=http://localhost:8005
ADMIN_APP_ORIGIN=http://localhost:8005

# Pricing Mode: "static" (default) uses config/payment.ts, "dynamic" uses database
PRICING_MODE="static"

# Welcome credits granted exactly once when a new account is created.
# Set to 0 to disable the grant.
CREDITS_NEW_USER_GRANT="1000"

# 推荐返利（默认关闭；启用后所有参与方案应使用同一佣金币种）
AFFILIATE_ENABLED="false"
AFFILIATE_COMMISSION_RATE="0.20"
AFFILIATE_CURRENCY="USD"
AFFILIATE_MIN_WITHDRAWAL="100"
AFFILIATE_COOKIE_EXPIRY_DAYS="30"
AFFILIATE_REFERRER_SIGNUP_BONUS="10"
AFFILIATE_REFEREE_SIGNUP_BONUS="10"

# 数据库配置
# DB_DIALECT: "pg" (default) for PostgreSQL, "sqlite" for local SQLite, "d1" for Cloudflare D1
DB_DIALECT="pg"
DATABASE_URL="postgresql://username:password@localhost:5432/vibechat"
# SQLITE_DB_PATH="./data/local.sqlite"  # Only used when DB_DIALECT=sqlite

# 认证配置
BETTER_AUTH_SECRET="your-secret-key-here-32-characters-minimum"
BETTER_AUTH_URL="http://localhost:8001"

# Matrix / Synapse Application Service. `pnpm dev` supplies the repository's
# deterministic local values and starts Synapse automatically. Configure these
# explicitly only when a process must connect to another environment.
# MATRIX_HOMESERVER_URL="http://localhost:8008"
# MATRIX_PUBLIC_HOMESERVER_URL="http://localhost:8008"
# MATRIX_SERVER_NAME="localhost"
# MATRIX_APPSERVICE_TOKEN="replace-with-appservice-as-token"
# 32 random bytes encoded as base64url (example generation: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
# MATRIX_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64url-key"
# MATRIX_USER_PREFIX="vibe_"

# OAuth 配置 （可选）

## Google Oauth 登录
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

## Github Oauth 登录
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

## 微信 OAuth 登录（可选）
NEXT_PUBLIC_WECHAT_APP_ID="your-wechat-app-id"
VITE_WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"


# 邮件服务（可选）
## Resend 配置
RESEND_API_KEY="your-resend-api-key"
EMAIL_DEFAULT_FROM="noreply@yourdomain.com"

## Cloudflare 通用账号凭据
# 这组变量当前用于 Cloudflare Email Sending
# 其中 CLOUDFLARE_ACCOUNT_ID 也可被 R2 配置回退复用
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

## Cloudflare Email Sending 说明
# - 邮件发送默认复用上面的 Cloudflare 通用账号变量
# - 发送域名需先在 Cloudflare Email Sending 中完成 onboarding
# - EMAIL_DEFAULT_FROM 必须属于已启用 Email Sending 的域名

# 阿里云通用配置（短信、OSS 等服务共用）
# 注意：这组密钥可同时用于阿里云短信和 OSS 存储服务
ALIYUN_ACCESS_KEY_ID="your-aliyun-key-id"
ALIYUN_ACCESS_KEY_SECRET="your-aliyun-key-secret"

# 短信服务（可选）

## 阿里云短信（使用上面的 ALIYUN_ACCESS_KEY）
ALIYUN_SMS_SIGN_NAME="your-sms-sign-name" #签名名称
ALIYUN_SMS_TEMPLATE_CODE="SMS_000000000" #模版Code

## TWILLO 短信
TWILIO_ACCOUNT_SID="AC1111111111111111"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_DEFAULT_FROM="+1234567890"

## 腾讯云短信（复用腾讯云通用密钥，与 COS 等服务共享）
TENCENT_SECRET_ID="your-tencent-secret-id"
TENCENT_SECRET_KEY="your-tencent-secret-key"
TENCENT_SMS_SDK_APP_ID="1400006666"        # 短信应用 SdkAppId
TENCENT_SMS_SIGN_NAME="your-sign-name"     # 短信签名
TENCENT_SMS_TEMPLATE_ID="123456"           # 默认模板 ID
# TENCENT_SMS_REGION="ap-guangzhou"        # 可选，默认 ap-guangzhou

# Captcha 验证码配置 (可选)

## Cloudflare TURNSTILE
TURNSTILE_SECRET_KEY="your-trunstile-secret-key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-trunstile-site-key"
# TanStack/Vite client build only (public, never use a Turnstile secret here)
VITE_TURNSTILE_SITE_KEY="your-trunstile-site-key"

# AI 服务（仅配置需要启用的 provider）
AI_PROVIDER="qwen"
QWEN_API_KEY="your-dashscope-api-key"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DEEPSEEK_API_KEY="your-deepseek-api-key"
OPENAI_API_KEY="your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
FAL_API_KEY="your-fal-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"
# GOOGLE_GENERATIVE_AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
VOLCENGINE_ACCESS_KEY_ID="your-volcengine-api-key"
# VOLCENGINE_BASE_URL="https://ark.cn-beijing.volces.com"

# 支付服务（仅配置需要启用的 provider）
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CREEM_API_KEY="creem_test_..."
CREEM_SERVER_URL="https://test-api.creem.io"
CREEM_WEBHOOK_SECRET="whsec_..."
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
PAYPAL_SANDBOX="true"
DODO_PAYMENTS_API_KEY="your-dodo-api-key"
DODO_PAYMENTS_WEBHOOK_KEY="your-dodo-webhook-key"
DODO_PAYMENTS_TEST_MODE="true"
ALIPAY_APP_ID="your-alipay-app-id"
ALIPAY_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_NOTIFY_URL="https://your-public-domain.example/api/payment/webhook/alipay"
ALIPAY_SANDBOX="true"
WECHAT_PAY_APP_ID="your-wechat-app-id"
WECHAT_PAY_MCH_ID="your-wechat-merchant-id"
WECHAT_PAY_API_KEY="your-wechat-v3-key"
WECHAT_PAY_NOTIFY_URL="https://your-public-domain.example/api/payment/webhook/wechat"
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_PAY_PUBLIC_KEY="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# WECHAT_PAY_PAYMENT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# WECHAT_PAY_PUBLIC_KEY_ID="PUB_KEY_ID_..."

# 存储配置 (可选)

## 存储提供商选择
STORAGE_PROVIDER="oss"  # 可选值: oss, s3, r2, cos
# TanStack Workers 客户端默认使用的上传提供商（CF 部署设为 r2）
VITE_STORAGE_PROVIDER="oss"
## 阿里云 OSS 配置
## 注意：如果已配置 ALIYUN_ACCESS_KEY_ID/SECRET，则无需重复配置下面两项
## OSS 会自动复用阿里云通用密钥
OSS_REGION="oss-cn-shanghai"
# OSS_ACCESS_KEY_ID="your-oss-access-key-id"      # 可选，默认使用 ALIYUN_ACCESS_KEY_ID
# OSS_ACCESS_KEY_SECRET="your-oss-access-key-secret"  # 可选，默认使用 ALIYUN_ACCESS_KEY_SECRET
OSS_BUCKET="your-bucket-name"
OSS_ENDPOINT="oss-cn-shanghai.aliyuncs.com"  # 可选

## AWS S3 配置
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_ACCESS_KEY_SECRET="your-s3-access-key-secret"
S3_BUCKET="your-bucket-name"
S3_ENDPOINT=""  # 可选：自定义端点（用于 S3 兼容服务）
S3_FORCE_PATH_STYLE="false"  # 可选：强制路径样式访问

## Cloudflare R2 配置
# 注意：R2 仍然需要自己独立的访问密钥；不会复用上面的 CLOUDFLARE_API_TOKEN
# 现在推荐直接使用上面的 CLOUDFLARE_ACCOUNT_ID
# 下面这个旧变量仅用于兼容旧配置；新项目通常不需要再单独设置
# R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_ACCESS_KEY_SECRET="your-r2-access-key-secret"
R2_BUCKET="your-bucket-name"
# Required for TanStack Cloudflare Workers uploads via the native R2 binding.
# Set up via Cloudflare dashboard: R2 > your bucket > Settings > Public access > Custom domain
R2_PUBLIC_URL="https://cdn.example.com"

## 腾讯云 COS 配置
## 注意：如果已配置 TENCENT_SECRET_ID/KEY，则无需重复配置下面两项
## COS 会自动复用腾讯云通用密钥
COS_REGION="ap-guangzhou"  # 地区，如 ap-guangzhou, ap-shanghai, ap-beijing
# COS_SECRET_ID="your-cos-secret-id"      # 可选，默认使用 TENCENT_SECRET_ID
# COS_SECRET_KEY="your-cos-secret-key"    # 可选，默认使用 TENCENT_SECRET_KEY
COS_BUCKET="your-bucket-name-appid"       # 格式：bucket-appid，如 example-1250000000

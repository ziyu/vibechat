{
  "name": "@vibechat/space-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "deploy:project": "node --env-file-if-exists=../../.env --import tsx src/deploy-workspace.ts"
  },
  "dependencies": {
    "@agentos-software/pi": "0.2.7",
    "@hono/node-server": "2.0.11",
    "@rivet-dev/agentos": "0.2.15",
    "@rivet-dev/agentos-apps": "0.2.15",
    "@vibechat/space-app-contracts": "workspace:*",
    "@vibechat/space-runtime-auth": "workspace:*",
    "@vibechat/space-templates": "workspace:*",
    "hono": "4.12.9",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.20.6"
  }
}

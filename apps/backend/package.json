{
  "name": "@vibechat/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8002",
    "dev:cf": "CF_DEPLOY=1 vite dev --port 8002",
    "preview:cf": "pnpm run build:cf && pnpm exec wrangler dev --port 8002",
    "build": "CF_DEPLOY=1 vite build",
    "build:node": "vite build",
    "build:cf": "CF_DEPLOY=1 vite build",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "deploy:cf": "pnpm run build:cf && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibechat/api-contracts": "workspace:*",
    "@vibechat/i18n": "workspace:*",
    "@vibechat/space-app-sdk": "workspace:*",
    "@vibechat/validators": "workspace:*",
    "@tanstack/react-router": "^1.120.3",
    "@tanstack/react-start": "^1.120.3",
    "drizzle-orm": "^0.40.1",
    "nanoid": "5.1.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "stripe": "18.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.33.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "nitro": "3.0.260610-beta",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "0.25.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "4.85.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibechat-backend",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d811cfad030643698c9c92f88f47ee34",
      "localConnectionString": "postgresql://viking:unused@localhost:5432/shipeasy_dev"
    }
  ],
  "vars": {
    "DB_DIALECT": "d1",
    "APP_BASE_URL": "http://localhost:8001",
    "BETTER_AUTH_URL": "http://localhost:8001",
    "VITE_STORAGE_PROVIDER": "r2"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "vibechat"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibechat-db",
      "database_id": "87ee7e74-c45a-447a-aa14-1a66130c306f",
      "migrations_dir": "../../libs/database/drizzle-sqlite"
    }
  ]
}
